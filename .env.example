# ==============================================================================
# Akademus - Template de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# ==============================================================================

# Ambiente da aplicação (development | testing | production)
FLASK_ENV=development

# Chave secreta de sessão Flask (gere uma chave forte de no mínimo 25 caracteres)
SECRET_KEY=gere_uma_chave_secreta_forte_aqui

# Conexão com o banco de dados MariaDB
DB_USER=akademus
DB_PASSWORD=senha_do_usuario_akademus_25_chars
DB_ROOT_PASSWORD=senha_de_root_do_mariadb_25_chars
DB_HOST=localhost
DB_PORT=3306
DB_NAME=akademus_db

# Domínio / URL base da aplicação
APP_HOST=akademus.tux.me.uk
HOST=0.0.0.0
PORT=8080

# Google OAuth 2.0 (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret

